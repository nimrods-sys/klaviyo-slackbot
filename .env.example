# Slack Configuration
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Klaviyo Configuration
# Get this from Klaviyo Settings > API Keys
KLAVIYO_API_KEY=pk_your-private-key-here

# Optional: timezone that defines a "day" for /emails-sent (IANA name, e.g. America/New_York).
# Defaults to the Klaviyo account timezone (needs Accounts: Read scope), otherwise UTC.
# KLAVIYO_TIMEZONE=America/New_York
